# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# regenerable artifacts: screenshots and audit reports are outputs, not source.
# /*.png is root-only on purpose: public/**/*.png stays tracked.
/*.png
REVIEW-*.md
.playwright-mcp/

# verification output: screenshots and audit dumps are never committed.
# Root-only globs again, so anything under public/ stays tracked.
/*.jpg
/*.jpeg
/*.webp
/screenshots/
/shots/
/scratchpad/
/.scratch/
/audit/
/test-results/
/playwright-report/

# local agent + editor state, not source
.claude/settings.local.json
.idea/
.vscode/
